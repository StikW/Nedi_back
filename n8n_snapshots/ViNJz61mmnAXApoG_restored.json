              "value": "={{ (() => { const bank = $('Get CourseModuleQuestions').first()?.json; const prog = $('Get Progress').first()?.json; const parseStatus = (s) => { if (s == null || s === '') return 0; if (typeof s === 'number' && !Number.isNaN(s)) return s; const n = Number(s); if (!Number.isNaN(n)) return n; const m = String(s).match(/pregunta\\s*(\\d+)/i); if (m) return Math.max(0, parseInt(m[1], 10) - 1); return 0; }; if (!bank?.questions) return null; let arr; try { arr = typeof bank.questions === 'string' ? JSON.parse(bank.questions) : bank.questions; } catch { return null; } if (!Array.isArray(arr) || arr.length === 0) return null; const idx = parseStatus(prog?.questionNumber); const q = arr[idx]; if (q === undefined) return '\u00a1Modulo finalizado!'; return typeof q === 'string' ? q : JSON.stringify(q); })() }}",
